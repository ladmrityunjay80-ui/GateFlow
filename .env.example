# GateFlow environment configuration
GATEFLOW_ADMIN_KEY=gateflow-admin-dev

# Secret used to one-way hash API keys. Change this before issuing real keys.
GATEFLOW_KEY_SECRET=gateflow-key-secret-change-in-production

REDIS_URL=redis://localhost:6379/0

# Redis Sentinel / HA (set this instead of REDIS_URL for production)
# Example: GATEFLOW_REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
GATEFLOW_REDIS_SENTINELS=
GATEFLOW_REDIS_SERVICE_NAME=mymaster
GATEFLOW_REDIS_SOCKET_CONNECT_TIMEOUT=1.0
GATEFLOW_REDIS_SOCKET_TIMEOUT=10.0
GATEFLOW_REDIS_HEALTH_CHECK_INTERVAL=30

# Redis AUTH / ACL (leave empty to disable)
GATEFLOW_REDIS_USERNAME=
GATEFLOW_REDIS_PASSWORD=

# Redis TLS in-transit
GATEFLOW_REDIS_SSL=false
GATEFLOW_REDIS_SSL_CERTFILE=
GATEFLOW_REDIS_SSL_KEYFILE=
GATEFLOW_REDIS_SSL_CA_CERTS=

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Rate limiter defaults (per tier unless overridden)
DEFAULT_TIER_CAPACITY=15
DEFAULT_TIER_REFILL_RATE=2.0

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=30.0
CIRCUIT_BREAKER_OPEN_DURATION=30.0

# Downstream request timeout
DOWNSTREAM_TIMEOUT_SECONDS=0.5

# Max inbound request body before rejecting
GATEFLOW_MAX_REQUEST_BODY_BYTES=1048576

# CORS (empty disables CORS middleware; comma-separated origins)
GATEFLOW_CORS_ORIGINS=

# TLS / mTLS (leave empty to disable)
GATEFLOW_SSL_CERTFILE=
GATEFLOW_SSL_KEYFILE=
GATEFLOW_SSL_CA_CERTS=
GATEFLOW_MTLS_ENABLED=false
